[importlinter]
root_packages =
    ed_telemetry
include_external_packages = True

[importlinter:contract:core_domain_isolation]
name = core_domain_isolation
type = forbidden
source_modules =
    ed_telemetry.core.domain
forbidden_modules =
    ed_telemetry.adapters
    external
    frameworks

[importlinter:contract:inward_dependency_direction]
name = inward_dependency_direction
type = layers
layers =
    ed_telemetry.adapters
    ed_telemetry.core.use_cases
    ed_telemetry.core.domain

[importlinter:contract:domain_port_isolation]
name = domain_port_isolation
type = forbidden
source_modules =
    ed_telemetry.core.domain
forbidden_modules =
    ed_telemetry.core.ports
    ed_telemetry.core.use_cases

[importlinter:contract:use_case_transport_isolation]
name = use_case_transport_isolation
type = forbidden
source_modules =
    ed_telemetry.core.use_cases
forbidden_modules =
    ed_telemetry.adapters
    fastapi
    starlette
    flask
    click
    typer

[importlinter:contract:composition_root_isolation]
name = composition_root_isolation
type = forbidden
source_modules =
    ed_telemetry.core.domain
    ed_telemetry.core.ports
    ed_telemetry.core.use_cases
    ed_telemetry.adapters
forbidden_modules =
    ed_telemetry.bootstrap

[importlinter:contract:anti_creep_framework_isolation]
name = anti_creep_framework_isolation
type = forbidden
source_modules =
    ed_telemetry
forbidden_modules =
    requests
    httpx
    aiohttp
    urllib3
    tkinter
    PyQt5
    PyQt6
    PySide6
    textual
